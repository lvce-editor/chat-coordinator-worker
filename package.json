{
  "name": "@lvce-editor/chat-coordinator-worker-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:static": "node packages/build/src/build-static.ts",
    "build:watch": "node packages/build/src/build-watch.ts",
    "dev": "node packages/build/src/dev.ts",
    "e2e": "cd packages/e2e && npm run e2e",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "measure": "cd packages/build && npm run measure",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.0.3",
    "eslint": "^10.7.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
